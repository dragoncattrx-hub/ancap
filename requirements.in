# Runtime dependency inputs for the ANCAP backend image and CI runtime lock.
# Regenerate requirements.txt from a Linux-compatible Python 3.11 environment so
# the lock stays valid for the Docker runtime image and does not capture
# Windows-only packages such as pywin32.
# Example:
#   docker run --rm -v ${PWD}:/work -w /work python:3.11-slim \
#     bash -lc "python -m pip install --no-cache-dir pip-tools && python -m piptools compile --generate-hashes --output-file requirements.txt requirements.in"
