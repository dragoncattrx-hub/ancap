# Copy to a file NOT committed to git (e.g. /etc/ancap/bridge.env) and pass to Docker:
#   docker compose --env-file ./deploy/bridge-mainnet.pilot.env.example -f docker-compose.prod.yml up -d
#
# BSC mainnet chain id 56. Use your own BSC RPC (Infura, QuickNode, etc.) in production.

# --- After `forge script` deploy (see docs/bridge-pilot-mainnet.md) ---
BRIDGE_RAIL_ENABLED=true
BRIDGE_RAIL_PAUSED=false
BRIDGE_DRY_RUN=false
BRIDGE_BSC_RPC_URL=https://bsc-dataseed.binance.org
# Paste deployed addresses (see docs/bridge-pilot-mainnet.md).
BRIDGE_WACP_CONTRACT=
BRIDGE_GATEWAY_CONTRACT=
# Native ACP address on ACP chain where the custodial reserve receives deposits (operator-controlled).
BRIDGE_RESERVE_ACP_ADDRESS=

# Strong random secret for POST /v1/bridge/admin/* (X-Bridge-Operator-Secret).
BRIDGE_OPERATOR_SECRET=

# Optional: ACP explorer base for tx links in API/UI (your explorer URL + /tx/ suffix pattern if applicable).
# ACP_EXPLORER_TX_BASE=
