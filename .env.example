# ANCAP Core API
# Copy to .env and adjust

# Runtime mode — "development" skips secret validation; "production" requires real secrets
ENVIRONMENT=development

# Database (sync URL for Alembic: use postgresql:// without +asyncpg)
# REQUIRED in production (ENVIRONMENT=production): do not use the local bundled-db default credentials there.
# If you use docker-compose.prod.yml with the bundled postgres service, also set POSTGRES_PASSWORD below
# and keep DATABASE_URL in sync with that real non-default password.
# Local dev example only. For the default docker-compose.yml stack, the bundled postgres service uses trust auth.
# Replace with a real passworded DSN for anything beyond throwaway local development.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/ancap
POSTGRES_PASSWORD=

# Auth — REQUIRED in production (ENVIRONMENT=production):
#   Generate with: openssl rand -hex 64
#   Never commit real keys to git. Store in CI secrets or a secret manager.
SECRET_KEY=
# Opaque cursor signing key — REQUIRED in production (ENVIRONMENT=production):
#   Generate with: openssl rand -hex 64
CURSOR_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_APP_URL=https://ancap.cloud
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Enables recovery-ready ACP wallet secret wrapping. Leave empty only if you intentionally want legacy password-only wallet encryption.
ACP_WALLET_RECOVERY_MASTER_KEY=
# Comma-separated user UUIDs allowed to approve admin-only monetization operations.
# If empty, local/dev builds allow any authenticated user to keep the operator workflow testable.
PLATFORM_ADMIN_USER_IDS=
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@ancap.cloud
SMTP_FROM_NAME=ANCAP Support
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
LOGIN_ALERTS_ENABLED=true

# LLM execution (Teneta/Claude-compatible Anthropic API by default)
LLM_PROVIDER=teneta_claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.tenetauniversity.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1800
LLM_DAILY_BUDGET_ACP=250
LLM_FALLBACK_TO_TEMPLATE=true

# Stripe / fiat adapter (optional; leave empty to keep ACP-only checkout surfaces)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1

# Referral auto-payouts (optional; leave disabled unless the ACP wallet helper + signer are configured)
REFERRAL_ONCHAIN_PAYOUT_ENABLED=false
REFERRAL_ONCHAIN_PAYOUT_KEYSTORE_FILE=
REFERRAL_ONCHAIN_PAYOUT_FEE_ACP=

# Redis-backed rate limits/cache/pubsub. Empty value keeps local in-memory fallback.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=240

# Cron job protection — REQUIRED in production (ENVIRONMENT=production)
# If set, POST /v1/system/jobs/tick and /v1/system/jobs/tick/async require X-Cron-Secret to match this value
# Generate with: openssl rand -hex 32  or  python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# Optional
DEBUG=false

# ----------------------------
# L3: Chain anchors (mock | acp | ethereum | solana)
# ----------------------------
# Driver selection for POST /v1/chain/anchor
CHAIN_ANCHOR_DRIVER=mock

# ACP node JSON-RPC endpoint (must support method: ancap_anchor)
ACP_RPC_URL=https://acp1.ancap.cloud/rpc

# Ethereum/Solana RPC endpoints must also support custom method ancap_anchor
# (regular public RPC endpoints will NOT have this method unless you run a shim/gateway)
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# ----------------------------
# Guarded rollout feature flags
# ----------------------------
FF_GRAPH_AUTO_ENFORCEMENT=false
FF_MUTATION_ENGINE=false
FF_GOVERNANCE_AUTO_APPLY=false
FF_EXTERNAL_ACTIONS=false
FF_NL_STRATEGY_COMPILER=false
