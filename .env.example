# ANCAP Core API
# Copy to .env and adjust

# Database (sync URL for Alembic: use postgresql:// without +asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ancap

# Auth
SECRET_KEY=your-long-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_APP_URL=https://ancap.cloud
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Enables recovery-ready ACP wallet secret wrapping. Leave empty only if you intentionally want legacy password-only wallet encryption.
ACP_WALLET_RECOVERY_MASTER_KEY=
# Comma-separated user UUIDs allowed to approve admin-only monetization operations.
# If empty, local/dev builds allow any authenticated user to keep the operator workflow testable.
PLATFORM_ADMIN_USER_IDS=
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@ancap.cloud
SMTP_FROM_NAME=ANCAP Support
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
LOGIN_ALERTS_ENABLED=true

# LLM execution (Teneta/Claude-compatible Anthropic API by default)
LLM_PROVIDER=teneta_claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.tenetauniversity.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1800
LLM_DAILY_BUDGET_ACP=250
LLM_FALLBACK_TO_TEMPLATE=true

# Redis-backed rate limits/cache/pubsub. Empty value keeps local in-memory fallback.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=240

# Cron job protection (optional, recommended for production)
# If set, POST /v1/system/jobs/tick requires X-Cron-Secret header to match this value
# Generate with: openssl rand -hex 32  or  python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# Optional
DEBUG=false

# ----------------------------
# L3: Chain anchors (mock | acp | ethereum | solana)
# ----------------------------
# Driver selection for POST /v1/chain/anchor
CHAIN_ANCHOR_DRIVER=mock

# ACP node JSON-RPC endpoint (must support method: ancap_anchor)
ACP_RPC_URL=https://acp1.ancap.cloud/rpc

# Ethereum/Solana RPC endpoints must also support custom method ancap_anchor
# (regular public RPC endpoints will NOT have this method unless you run a shim/gateway)
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# ----------------------------
# Guarded rollout feature flags
# ----------------------------
FF_GRAPH_AUTO_ENFORCEMENT=false
FF_MUTATION_ENGINE=false
FF_GOVERNANCE_AUTO_APPLY=false
FF_EXTERNAL_ACTIONS=false
FF_NL_STRATEGY_COMPILER=false
