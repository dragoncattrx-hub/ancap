{
  "expo": {
    "name": "ANCAP ACP Wallet",
    "slug": "acp-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "acpwallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.ancap.acpwallet"
    },
    "android": {
      "package": "cloud.ancap.acpwallet"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow ANCAP ACP Wallet to use Face ID to unlock secure vault secrets on this device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ANCAP ACP Wallet to verify it is really you before unlocking the wallet."
        }
      ],
      "expo-acp-core"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
