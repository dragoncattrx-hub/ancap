# Copy to .env for local overrides (optional — app.config.js sets production defaults).
EXPO_PUBLIC_ANCAP_API_BASE=https://api.ancap.cloud/v1
EXPO_PUBLIC_ACP_RPC_URL=https://acp1.ancap.cloud/rpc
EXPO_NO_METRO_WORKSPACE_ROOT=1

# Optional dev/test-only bearer for authenticated Smart Pay history (never ship secrets in release).
# EXPO_PUBLIC_ANCAP_API_AUTH_HEADER=Bearer your-dev-token

# Local API:
# EXPO_PUBLIC_ANCAP_API_BASE=http://127.0.0.1:8000/v1
