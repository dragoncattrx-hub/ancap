{
  "name": "ancap-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "ANCAP ACP Wallet — React Native monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "npm run build -w @ancap/acp-wallet-sdk && npm run build -w @ancap/acp-api-client && npm run build -w @ancap/acp-bridge-client && npm run build -w @ancap/acp-bsc-client",
    "postinstall": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:expo": "npm run test -w @ancap/acp-wallet-expo --",
    "test:expo:smart-pay": "npm run test -w @ancap/acp-wallet-expo -- smart-pay",
    "test:api-client": "npm run test -w @ancap/acp-api-client --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:expo": "npm run typecheck -w @ancap/acp-wallet-expo",
    "typecheck:api-client": "npm run typecheck -w @ancap/acp-api-client",
    "app:start": "npm run start -w @ancap/acp-wallet-expo",
    "app:expo": "npm run start -w @ancap/acp-wallet-expo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo": "~52.0.28",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "react-native": "0.76.6",
    "react": "18.3.1",
    "react-native-svg": "15.8.0",
    "@xmldom/xmldom": "^0.9.10",
    "ajv": "8.20.0",
    "expo-dev-launcher": {
      "ajv": "8.20.0"
    },
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.2",
    "postcss": "^8.5.10",
    "tar": "^7.5.16",
    "undici": "^6.28.0",
    "uuid": "^11.1.1",
    "vite": "^6.4.3"
  }
}
